# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored and must never be committed.

# PostgreSQL
DB_URL=jdbc:postgresql://127.0.0.1:5433/user_db
DB_USERNAME=banking_admin
DB_PASSWORD=change-me

# Redis (e-mail rate limiter)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Eureka
EUREKA_URL=http://localhost:8761/eureka

# JWT signing key - must be identical to the api-gateway app.jwt.secret
JWT_SECRET=change-me-at-least-32-characters-long

# Base64 32-byte AES key - must be identical to the notification-service key
# generate with: openssl rand -base64 32
EVENT_CRYPTO_KEY=change-me

# Front-end verification page
VERIFY_URL=http://localhost:3000/verify.html
